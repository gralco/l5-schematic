(version 1)

(rule "DiffPair_D1_gap"
  (condition "A.NetName == '4G_MIPI_SCL' && B.NetName == '4G_MIPI_SDA'")
  (constraint clearance (min 0.0889mm)))

(rule "DiffPair_D2_gap"
  (condition "A.NetName == 'USB2_WIFI_DN' && B.NetName == 'USB2_WIFI_DP'")
  (constraint clearance (min 0.07112mm)))

